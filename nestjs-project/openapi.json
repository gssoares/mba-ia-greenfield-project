  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "example": "my-video.mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 134217728
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "content_type"
        ]
      },
      "VideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "aB3xQ9zK1pL"
          },
          "processing_status": {
            "type": "string",
            "example": "uploading"
          },
          "part_size_bytes": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 2
          },
          "created_at": {
            "type": "string",
            "example": "2026-09-17T12:00:00.000Z"
          }
        },
        "required": [
          "public_id",
